{
    "name": "conquer/helpers",
    "description": "Yii2 helpers",
    "keywords": [
        "yii2",
        "extension",
        "widget",
        "helpers"
    ],
    "homepage": "https://github.com/borodulin/yii2-helpers",
    "type": "yii2-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/borodulin/yii2-helpers/issues",
        "source": "https://github.com/borodulin/yii2-helpers"
    },
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "2.2.x-dev"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "^2.0.14"
    },
    "autoload": {
        "psr-4": {
            "conquer\\helpers\\": ""
        }
    },
    "require-dev": {
        "codeception/codeception": "^4.2 || ^5.0",
        "codeception/module-asserts": "^2.0 || ^3.0"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/_support/",
            "tests\\unit\\": "tests/unit/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
